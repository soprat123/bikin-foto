{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bikin-foto",
  "main": "src/internal-qris-entry.js",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bikin-foto-db",
      "database_id": "43831eca-22e7-4eca-b6c3-d21f3efadaed",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "vars": {
    "QRIS_PAYMENT_URL": "https://qris-dinamis-telegram.merapatsoprat.workers.dev"
  }
}
